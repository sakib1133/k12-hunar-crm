# Copy server-side values to server/.env. Never put secrets in client/.env.
NODE_ENV=development
PORT=4000
# Supabase Database Settings > SSL Configuration > CA certificate (production only).
DATABASE_SSL_CA=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_ORIGIN=http://localhost:5173

# Used only by the one-time initial admin creation command.
ADMIN_NAME=K12 Hunar Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional. Leave blank for local Vite proxy and same-origin production routing.
VITE_API_BASE_URL=
